{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 悬浮待办 (app.pyw)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.pyw",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "调试 pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q", "--ignore=tests/gui_smoke.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
